# Environment
venv/
__pycache__/

# Performance Data (Local only)
performance.json

# System
.DS_Store

# IDE
.vscode/
.idea/

# Any generated media from the script such as .jpg, .mp3, .mp4, etc.
*.jpg
*.gif
*.png
*.webp
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav

# Allow screenshots folder (README images)
!screenshots/
!screenshots/**

# Test Data - ignore outputs (and subfolders), keep inputs
testData/outputs/**

# Unignore testData/inputs (need to unignore parent first, then contents)
!testData/
!testData/inputs/
!testData/inputs/**

# Allow testing.json to be committed
!testing.json