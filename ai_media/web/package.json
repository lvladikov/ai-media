{
  "name": "ai-media-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "cd ../.. && source venv/bin/activate && python ai-media.py --serve",
    "dev:both": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "npm run --prefix packages/electron start",
    "electron:build:mac:arm64": "npm run --prefix packages/electron build:mac:arm64",
    "electron:build:mac:x64": "npm run --prefix packages/electron build:mac:x64",
    "electron:build:mac:universal": "npm run --prefix packages/electron build:mac:universal",
    "electron:build:mac:all": "npm run --prefix packages/electron build:mac:all",
    "electron:build:win:x64": "npm run --prefix packages/electron build:win:x64",
    "electron:build:win:arm64": "npm run --prefix packages/electron build:win:arm64",
    "electron:build:win:all": "npm run --prefix packages/electron build:win:all",
    "electron:build:linux:x64": "npm run --prefix packages/electron build:linux:x64",
    "electron:build:linux:arm64": "npm run --prefix packages/electron build:linux:arm64",
    "electron:build:linux:all": "npm run --prefix packages/electron build:linux:all",
    "electron:build:all": "npm run --prefix packages/electron build:all"
  },
  "dependencies": {
    "@types/dom-to-image": "^2.6.7",
    "@types/prismjs": "^1.26.5",
    "dom-to-image": "^2.6.0",
    "lucide-react": "^0.562.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
