# Environment
venv/
__pycache__/

# Performance Data (Local only)
performance.json

# System
.DS_Store

# IDE
.vscode/
.idea/

# Any generated media from the script such as .jpg, .mp3, .mp4, etc.
*.jpg
*.gif
*.png
*.webp
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.txt
*.wmv

# Allow screenshots folder (README images)
!screenshots/
!screenshots/**

# Allow tests folder to be committed (but we'll ignore outputs below)
!tests/
!tests/**

# Re-ignore test outputs and pycache (after unignoring tests/**)
tests/testData/outputs/
tests/__pycache__/